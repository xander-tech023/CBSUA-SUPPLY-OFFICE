{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "None",
    "strict": true,
    "alwaysStrict": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "./TypeScript",
    "outDir": "./TypeScript",
    "types": []
  },
  "include": ["TypeScript/**/*.ts"],
  "exclude": ["node_modules", "vite-cbsua_supply_office"]
}
